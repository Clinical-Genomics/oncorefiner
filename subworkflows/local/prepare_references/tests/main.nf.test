nextflow_workflow {

    name "Test Subworkflow PREPARE_REFERENCES"
    script "../main.nf"
    workflow "PREPARE_REFERENCES"
    tag "subworkflows"
    tag "prepare_references"
    config "./nextflow.config"

    test("Test preparing VEP cache: no untarring needed") {

        when {

            params {
                outdir = "$outputDir"
            }
            // Provided path to mock input (subworkflow wants value with path to directory) - should be improved in the future
            workflow {
                """
                input[0] =  'path/to/vep_cache_untarred'
                """
            }
        }

        then {

            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    // Check the name of the output directory
                    workflow.out.vep_resources[0][0].tokenize('/').last(),
                ).match() }
            )
        }
    }

    test("Test preparing VEP cache: no untarring needed - stub") {

        options "-stub"

        when {

            params {
                outdir = "$outputDir"
            }
            // Provided path to mock input (subworkflow wants value with path to directory) - should be improved in the future
            workflow {
                """
                input[0] = 'path/to/vep_cache_untarred'
                """
            }
        }

        then {

            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    // Check the name of the output directory
                    workflow.out.vep_resources[0][0].tokenize('/').last(),
                ).match() }
            )
        }
    }

    test("Test preparing VEP cache: untarring needed") {

        when {

            workflow {
                """
                input[0] = params.pipelines_testdata_base_path + 'reference/GRCh38/vep_cache.tar.gz'
                """
            }
        }

        then {
            // Check untarred directory and files
            def output_directories_files = getAllFilesFromDir(workflow.out.vep_resources[0][0], relative: true, includeDir: true)

            assertAll(
                { assert workflow.success },
                { assert snapshot(
					// Check the name of the output directory
                    workflow.out.vep_resources[0][0].tokenize('/').last(),
                    // Check untarred directory and files
                    output_directories_files
                ).match() }
            )
        }
    }

    test("Test preparing VEP cache: untarring needed - stub") {

        options "-stub"

        when {

            workflow {
                """
                input[0] = params.pipelines_testdata_base_path + 'reference/GRCh38/vep_cache.tar.gz'
                """
            }
        }

        then {
            // Check untarred directory and files
            def output_directories_files = getAllFilesFromDir(workflow.out.vep_resources[0][0], relative: true, includeDir: true)

            assertAll(
                { assert workflow.success },
                { assert snapshot(
					// Check the name of the output directory
                    workflow.out.vep_resources[0][0].tokenize('/').last(),
                    // Check untarred directory and files
                    output_directories_files
                ).match() }
            )
        }
    }

}
