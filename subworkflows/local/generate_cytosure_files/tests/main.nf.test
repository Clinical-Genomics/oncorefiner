nextflow_workflow {

    name "Test Workflow GENERATE_CYTOSURE_FILES"
    script "../main.nf"
    workflow "GENERATE_CYTOSURE_FILES"
    config "./nextflow.config"
    tag "subworkflows"
    tag "generate_cytosure_files"

    topics "versions"

    test("Alignment files from Tumor sample and somatic SV vcf files from TN test data") {

        when {
            params {
                genome_version_number = 38
                sex                   = 'female'
            }

            workflow {
                """
                input[0] = channel.of([
                    ['type':'tumor'],
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/subject_a.tumor.redux.bam', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/subject_a.tumor.redux.bam.bai', checkIfExists: true)
                ])
                input[1] = channel.of([
                    [id:'subject_a'],
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_normal/subject_a.tumor.purple.sv.vcf.gz.tbi', checkIfExists: true)
                ])
                input[2] = channel.of([
                    [id:'subject_a'],
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_normal/subject_a.tumor.purple.sv.vcf.gz', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    topics,
                    workflow.out
                ).match() }
            )
        }
    }

    test("Alignment files from Tumor sample and somatic SV vcf files from TN test data - stub") {

        options "-stub"

        when {
            params {
                genome_version_number = 38
                sex                   = 'female'
            }

            workflow {
                """
                input[0] = channel.of([
                    ['type':'tumor'],
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/subject_a.tumor.redux.bam', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/subject_a.tumor.redux.bam.bai', checkIfExists: true)
                ])
                input[1] = channel.of([
                    [id:'subject_a'],
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_normal/subject_a.tumor.purple.sv.vcf.gz.tbi', checkIfExists: true)
                ])
                input[2] = channel.of([
                    [id:'subject_a'],
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_normal/subject_a.tumor.purple.sv.vcf.gz', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    topics,
                    workflow.out
                ).match() }
            )
        }
    }
}
