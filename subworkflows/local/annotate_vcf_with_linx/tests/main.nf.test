nextflow_workflow {
    name "Test subworkflow ANNOTATE_VCF_WITH_LINX"
    script "../main.nf"
    config "./nextflow.config"
    workflow "ANNOTATE_VCF_WITH_LINX"
    tag "subworkflows"
    tag "annotate_vcf_with_linx"
    topics "versions"

    test("Annotate VCF with LINX tsv") {

        when {

            workflow {
                """
                input[0] = channel.of([
                    [id: 'test', case_id: 'subject_a'],
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_normal/subject_a.tumor.linx.breakend.tsv', checkIfExists: true)
                ])
                input[1] = channel.of([
                    [id: 'test', case_id: 'subject_a'],
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_normal/subject_a.tumor.linx.fusion.tsv', checkIfExists: true)
                ])
                input[2] = channel.of([
                    [id: 'test', case_id: 'subject_a'],
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_normal/subject_a.tumor.linx.svs.tsv', checkIfExists: true)
                ])
                input[3] = channel.of([
                    [id: 'test', case_id: 'subject_a'],
                    file('$projectDir/assets/sv_annotation_header.txt', checkIfExists: true)
                ])
                input[4] = channel.of([
                    [id: 'test', case_id: 'subject_a'],
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_normal/subject_a.tumor.purple.sv.vcf.gz', checkIfExists: true)
                ])
                input[5] = channel.of([
                    [id: 'test', case_id: 'subject_a'],
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_normal/subject_a.tumor.purple.sv.vcf.gz.tbi', checkIfExists: true)
                ])

                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.out.vcf.collect { meta, vcf -> [meta, file(vcf).name + ":variantsMD5," + path(vcf).vcf.variantsMD5 ]} ,
                    workflow.out.tbi.collect { meta, tbi -> [meta, file(tbi).name ]} ,
                    topics
                ).match() }
            )
        }
    }
    test("Annotate VCF with LINX tsv - stub") {

        options "-stub"

        when {

            workflow {
                """
                input[0] = channel.of([
                    [id: 'test', case_id: 'subject_a'],
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_normal/subject_a.tumor.linx.breakend.tsv', checkIfExists: true)
                ])
                input[1] = channel.of([
                    [id: 'test', case_id: 'subject_a'],
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_normal/subject_a.tumor.linx.fusion.tsv', checkIfExists: true)
                ])
                input[2] = channel.of([
                    [id: 'test', case_id: 'subject_a'],
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_normal/subject_a.tumor.linx.svs.tsv', checkIfExists: true)
                ])
                input[3] = channel.of([
                    [id: 'test', case_id: 'subject_a'],
                    file('$projectDir/assets/sv_annotation_header.txt', checkIfExists: true)
                ])
                input[4] = channel.of([
                    [id: 'test', case_id: 'subject_a'],
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_normal/subject_a.tumor.purple.sv.vcf.gz', checkIfExists: true)
                ])
                input[5] = channel.of([
                    [id: 'test', case_id: 'subject_a'],
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_normal/subject_a.tumor.purple.sv.vcf.gz.tbi', checkIfExists: true)
                ])

                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.out
                ).match() }
            )
        }
    }
}
