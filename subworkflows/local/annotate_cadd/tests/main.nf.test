nextflow_workflow {

    name "Test Subworkflow ANNOTATE_CADD"
    script "../main.nf"
    workflow "ANNOTATE_CADD"
    tag "subworkflows"
    tag "annotate_cadd"
    config "./nextflow.config"

    topics "versions"

    test("ANNOTATE_CADD - GRCh37, stub") {

        options "-stub"

        when {
            params {
                genome = "GRCh37"
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of([
                    [id: 'test_tumor_normal_case', case_id: 'test_tumor_normal_case'],
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh37/tumor_normal/subject_a.tumor.purple.somatic.vcf.gz', checkIfExists: true)
                    ])
                input[1] = 'GRCh37'
                input[2] = channel.fromPath(params.pipelines_testdata_base_path + 'reference/GRCh37/reference.fasta.fai', checkIfExists: true).map {it -> [[id:it.simpleName], it]  }.collect()
                input[3] = channel.fromPath("$projectDir/assets/cadd_to_vcf_header.txt", checkIfExists: true).collect()
                // Mock input directories for CADD resources and pre-scored indels, as the stub workflow will not actually read from these directories
                input[4] = channel.from("$projectDir/assets/").map { dir -> [ [ id: 'cadd_resources' ], dir ] }
                input[5] = channel.from("$projectDir/docs/").map { dir -> [ [ id: 'cadd_prescored_indels' ], dir ] }
                """
            }
        }

        then {

            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    sanitizeOutput(workflow.out),
                    topics
                ).match() }
            )
        }
    }

    test("ANNOTATE_CADD - GRCh38, stub") {
    // TODO update test data to GRCh38
        options "-stub"

        when {
            params {
                genome = "GRCh38"
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of([
                    [id: 'test_tumor_normal_case', case_id: 'test_tumor_normal_case'],
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_normal/subject_a.tumor.purple.somatic.vcf.gz', checkIfExists: true)
                    ])
                input[1] = 'GRCh38'
                input[2] = channel.fromPath(params.pipelines_testdata_base_path + 'reference/GRCh38/GRCh38_masked_exclusions_alts_hlas_subset.fasta.fai', checkIfExists: true).map {it -> [[id:it.simpleName], it]  }.collect()
                input[3] = channel.fromPath("$projectDir/assets/cadd_to_vcf_header.txt", checkIfExists: true).collect()
                // Mock input directories for CADD resources and pre-scored indels, as the stub workflow will not actually read from these directories
                input[4] = channel.from("$projectDir/assets/").map { dir -> [ [ id: 'cadd_resources' ], dir ] }
                input[5] = channel.from("$projectDir/docs/").map { dir -> [ [ id: 'cadd_prescored_indels' ], dir ] }
                """
            }
        }

        then {

            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    sanitizeOutput(workflow.out),
                    topics
                ).match() }
            )
        }
    }

}
