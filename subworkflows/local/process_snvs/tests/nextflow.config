/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
 Defines input files and everything required to run a fast and simple pipeline test.

*/

process {
    withName:'BCFTOOLS_VIEW_RESEARCH' {
        ext.prefix = { "${meta.id}_research" }
        ext.args   = {
            ["${params.extra_snv_research_filter_args}",
            ' --output-type z --write-index=tbi '].join(' ')
        }
    }

    withName:'BCFTOOLS_VIEW_CLINICAL' {
        ext.prefix = { "${meta.id}_clinical" }
        ext.args   = {
            ["${params.extra_snv_clinical_filter_args}",
            ' --output-type z --write-index=tbi '].join(' ')
        }
    }

}
