/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
 Defines input files and everything required to run a fast and simple pipeline test.

*/

process {

   withName: 'VCFANNO' {
      ext.prefix = { "${meta.id}_vcfanno" }
   }

   withName:'BCFTOOLS_VIEW_RESEARCH' {
      ext.prefix = { "${meta.id}_research" }
      ext.args   = {
            ["${params.extra_snv_research_filter_args}",
            ' --output-type z --write-index=tbi '].join(' ')
        }
      publishDir = [
            path: { "${params.outdir}/research_filtering" },
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
   }

   withName: 'ENSEMBLVEP_VEP' {
        ext.prefix = { "${meta.id}_vep" }
        ext.args   = {
            ["${params.extra_snv_vep_args}",
            '--everything --hgvsg --allow_non_variant --dont_skip --variant_class --verbose',
            '--vcf --buffer_size 20000 --max_sv_size 248956422',
            '--format vcf --offline --merged  --cache --force_overwrite'
            ].join(' ')
        }
        publishDir = [
            path: { "${params.outdir}/vep" },
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
   }

   withName:'BCFTOOLS_VIEW_CLINICAL' {
      ext.prefix = { "${meta.id}_clinical" }
      ext.args   = {
            ["${params.extra_snv_clinical_filter_args}",
            ' --output-type z --write-index=tbi '].join(' ')
        }
      publishDir = [
            path: { "${params.outdir}/clinical_filtering" },
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
   }

}
