process {
    withName:'.*BCFTOOLS_VIEW_RESEARCH' {
      ext {
         prefix = { "${meta.id}_research" }
         args = """ --output-type z --write-index=tbi --include '(INFO/GNOMADAF_grpmax <= 0.001 || INFO/GNOMADAF_grpmax == ".")' """
      }
   }

       withName:'.*BCFTOOLS_VIEW_CLINICAL' {
      ext {
         prefix = { "${meta.id}_clinical" }
         args = """ --output-type z --write-index=tbi --include '(INFO/GNOMADAF_grpmax <= 0.001 || INFO/GNOMADAF_grpmax == ".")' """
      }
    }
}
