nextflow_workflow {

    name "Test subworkflow PROCESS_SNVS"
    script "../main.nf"
    config './nextflow.config'
    workflow "PROCESS_SNVS"
    tag "subworkflows"
    tag "process_snvs"


    test("with tumor-normal data") {

        setup {
            run("UNTAR", alias: "UNTAR_VEP_CACHE") {
                script "modules/nf-core/untar/main.nf"
                process {
                    """
                    input[0] = channel.of([
                        [id:'vep_cache'],
                        file(params.pipelines_testdata_base_path + 'reference/GRCh38/vep_cache.tar.gz', checkIfExists: true)
                    ])
                    """
                    }
                }
        }

        when {
            params {
                outdir = "$outputDir"
            }

            workflow {
                """
                input[0] = channel.of([
                    [id:'reference'],
                    file(params.pipelines_testdata_base_path + 'reference/GRCh38/GRCh38_masked_exclusions_alts_hlas_subset.fasta', checkIfExists: true)
                ])
                input[1] = channel.fromPath(params.pipelines_testdata_base_path + 'reference/GRCh38/GRCh38_masked_exclusions_alts_hlas_subset.fasta.fai', checkIfExists: true).map {it -> [[id:it.simpleName], it]  }.collect()
                input[2] = channel.fromPath("$projectDir/assets/cadd_to_vcf_header.txt", checkIfExists: true).collect()
                input[3] = null
                input[4] = null
                input[5] = channel.of([
                    [id:'subject_a'],
                    file(params.pipelines_testdata_base_path + 'reference/genmod_score_config_snv.ini', checkIfExists: true)
                ])
                input[6] = channel.of([
                    [id:'subject_a'],
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_normal/subject_a.tumor.purple.somatic.vcf.gz', checkIfExists: true)
                ])
                input[7] = channel.of([
                    [id:'subject_a'],
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_normal/subject_a.tumor.purple.somatic.vcf.gz.tbi', checkIfExists: true)
                ])
                input[8] = []
                input[9] = channel.of([
                    file(params.pipelines_testdata_base_path + 'reference/GRCh38/vcfanno_functions.lua', checkIfExists: true)
                ])
                input[10] = channel.of([
                    file(params.pipelines_testdata_base_path + 'reference/GRCh38/grch38_gnomad_reformatted_merged_v4.1_subset.vcf.gz', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'reference/GRCh38/grch38_gnomad_reformatted_merged_v4.1_subset.vcf.gz.tbi', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'reference/GRCh38/grch38_swegen_frequencies_fixploidy_-20190204_subset.vcf.gz', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'reference/GRCh38/grch38_swegen_frequencies_fixploidy_-20190204_subset.vcf.gz.tbi', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'reference/GRCh38/whole_genome_SNVs_chr_subset.tsv.gz', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'reference/GRCh38/whole_genome_SNVs_chr_subset.tsv.gz.tbi', checkIfExists: true)

                ])
                input[11] = channel.of([
                    file(params.pipelines_testdata_base_path + 'reference/GRCh38/grch38_vcfanno_config.toml', checkIfExists: true)
                ])
                input[12] = UNTAR_VEP_CACHE.out.untar.map{ _meta, files -> [files]}.collect()
                input[13] = channel.of([
                    file(params.pipelines_testdata_base_path + 'reference/GRCh38/LoFtool_scores.txt', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'reference/GRCh38/pLI_values.txt', checkIfExists: true)
                ])
                input[14] = null
                input[15] = 'GRCh38'
                input[16] = true
                input[17] = 'homo_sapiens'
                input[18] = '115'
                """
            }
        }

        then {
            // All output VCF files with stable variants
            def output_vcfs = workflow.out.findAll { key, value -> key.endsWith('_vcf')}
                .collectMany { key, value -> value}

            // All output tbi files
            def output_tbis = workflow.out.findAll { key, value -> key.endsWith('_tbi')}
                .collectMany { key, value -> value}

            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    output_vcfs.collect { meta, vcf -> [meta, file(vcf).name, ":variantsMD5,", path(vcf).vcf.variantsMD5 ]},
                    output_tbis.collect { meta, tbi -> [meta, file(tbi).name] },
                    workflow.out.vep_report.collect { meta, _process, _tool, report -> [meta, file(report).name] },
                ).match() }
            )
        }
    }

    test("with tumor-normal data - stub") {

        options "-stub"

        setup {
            run("UNTAR", alias: "UNTAR_VEP_CACHE") {
                script "modules/nf-core/untar/main.nf"
                process {
                    """
                    input[0] = channel.of([
                        [id:'vep_cache'],
                        file(params.pipelines_testdata_base_path + 'reference/GRCh38/vep_cache.tar.gz', checkIfExists: true)
                    ])
                    """
                    }
                }
        }

        when {
            params {
                outdir = "$outputDir"
            }

            workflow {
                """
                input[0] = channel.of([
                    [id:'reference'],
                    file(params.pipelines_testdata_base_path + 'reference/GRCh38/GRCh38_masked_exclusions_alts_hlas_subset.fasta', checkIfExists: true)
                ])
                input[1] = channel.fromPath(params.pipelines_testdata_base_path + 'reference/GRCh38/GRCh38_masked_exclusions_alts_hlas_subset.fasta.fai', checkIfExists: true).map {it -> [[id:it.simpleName], it]  }.collect()
                input[2] = channel.fromPath("$projectDir/assets/cadd_to_vcf_header.txt", checkIfExists: true).collect()
                input[3] = null
                input[4] = null
                input[5] = channel.of([
                    [id:'subject_a'],
                    file(params.pipelines_testdata_base_path + 'reference/genmod_score_config_snv.ini', checkIfExists: true)
                ])
                input[6] = channel.of([
                    [id:'subject_a'],
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_normal/subject_a.tumor.purple.somatic.vcf.gz', checkIfExists: true)
                ])
                input[7] = channel.of([
                    [id:'subject_a'],
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_normal/subject_a.tumor.purple.somatic.vcf.gz.tbi', checkIfExists: true)
                ])
                input[8] = []
                input[9] = channel.of([
                    file(params.pipelines_testdata_base_path + 'reference/GRCh38/vcfanno_functions.lua', checkIfExists: true)
                ])
                input[10] = channel.of([
                    file(params.pipelines_testdata_base_path + 'reference/GRCh38/grch38_gnomad_reformatted_merged_v4.1_subset.vcf.gz', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'reference/GRCh38/grch38_gnomad_reformatted_merged_v4.1_subset.vcf.gz.tbi', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'reference/GRCh38/grch38_swegen_frequencies_fixploidy_-20190204_subset.vcf.gz', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'reference/GRCh38/grch38_swegen_frequencies_fixploidy_-20190204_subset.vcf.gz.tbi', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'reference/GRCh38/whole_genome_SNVs_chr_subset.tsv.gz', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'reference/GRCh38/whole_genome_SNVs_chr_subset.tsv.gz.tbi', checkIfExists: true)

                ])
                input[11] = channel.of([
                    file(params.pipelines_testdata_base_path + 'reference/GRCh38/grch38_vcfanno_config.toml', checkIfExists: true)
                ])
                input[12] = UNTAR_VEP_CACHE.out.untar.map{ _meta, files -> [files]}.collect()
                input[13] = channel.of([
                    file(params.pipelines_testdata_base_path + 'reference/GRCh38/LoFtool_scores.txt', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'reference/GRCh38/pLI_values.txt', checkIfExists: true)
                ])
                input[14] = null
                input[15] = 'GRCh38'
                input[16] = true
                input[17] = 'homo_sapiens'
                input[18] = '115'
                """
            }
        }

        then {
            // All output VCF files with stable variants
            def output_vcfs = workflow.out.findAll { key, value -> key.endsWith('_vcf')}
                .collectMany { key, value -> value}

            // All output tbi files
            def output_tbis = workflow.out.findAll { key, value -> key.endsWith('_tbi')}
                .collectMany { key, value -> value}

            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    output_vcfs.collect { meta, vcf -> [meta, file(vcf).name ]},
                    output_tbis.collect { meta, tbi -> [meta, file(tbi).name] },
                    workflow.out.vep_report.collect { meta, _process, _tool, report -> [meta, file(report).name] },
                ).match() }
            )
        }
    }
}
