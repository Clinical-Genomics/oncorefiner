nextflow_workflow {

    name "Test subworkflow PROCESS_SNVS"
    script "../main.nf"
    workflow "PROCESS_SNVS"
    tag "subworkflows"
    tag "process_snvs"



    test("with tumor-normal GRCh37 data") {

        setup {
        run("UNTAR", alias: "UNTAR_VEP_CACHE") {
            script "modules/nf-core/untar/main.nf"
            process {
                """
                input[0] = channel.of([
                    [id:'vep_cache'],
                    file(params.pipelines_testdata_base_path + 'reference/GRCh37/vep_cache_and_plugins.tar.gz', checkIfExists: true)
                ])
                """
                }
            }
        }

        when {
            params {
                outdir = "$outputDir"
            }

            workflow {
                """
                input[0] = channel.of([
                    [id:'reference'],
                    file(params.pipelines_testdata_base_path + 'reference/GRCh37/reference.fasta', checkIfExists: true)
                ])
                input[1] = channel.fromPath(params.pipelines_testdata_base_path + 'reference/GRCh37/reference.fasta.fai', checkIfExists: true).map {it -> [[id:it.simpleName], it]  }.collect()
                input[2] = channel.fromPath("$projectDir/assets/cadd_to_vcf_header.txt", checkIfExists: true).collect()
                input[3] = null
                input[4] = null
                input[5] = channel.of([
                    [id:'subject_a'],
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh37/tumor_normal/subject_a.tumor.purple.somatic.vcf.gz', checkIfExists: true)
                ])
                input[6] = channel.of([
                    [id:'subject_a'],
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh37/tumor_normal/subject_a.tumor.purple.sv.vcf.gz', checkIfExists: true)
                ])
                input[7] = []
                input[8] = channel.of([
                    file(params.pipelines_testdata_base_path + 'reference/GRCh37/vcfanno_functions.lua', checkIfExists: true)
                ])
                input[9] = channel.of([
                    file(params.pipelines_testdata_base_path + 'reference/GRCh37/grch37_gnomad_-r2.1.1-.vcf.gz', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'reference/GRCh37/grch37_gnomad_-r2.1.1-.vcf.gz.tbi', checkIfExists: true)
                ])
                input[10] = channel.of([
                    file(params.pipelines_testdata_base_path + 'reference/GRCh37/vcfanno.toml', checkIfExists: true)
                ])
                input[11] = UNTAR_VEP_CACHE.out.untar.map{ _meta, files -> [files]}.collect()
                input[12] = channel.of([
                    file(params.pipelines_testdata_base_path + 'reference/GRCh37/LoFtool_scores.txt', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'reference/GRCh37/spliceai_21_scores_raw_indel_-v1.3-.vcf.gz', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'reference/GRCh37/spliceai_21_scores_raw_snv_-v1.3-.vcf.gz', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'reference/GRCh37/pLI_values.txt', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'reference/GRCh37/spliceai_21_scores_raw_indel_-v1.3-.vcf.gz.tbi', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'reference/GRCh37/spliceai_21_scores_raw_snv_-v1.3-.vcf.gz.tbi', checkIfExists: true)
                ])
                input[13] = null
                input[14] = 'GRCh37'
                input[15] = 'homo_sapiens'
                input[16] = '107'
                """
            }
        }

        then {
            // All files and directories in the output directory, excluding the untar directories and files
            def output_directories_and_files = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['untar**'])
            // vcfs_with_stable_variants: Vcf files with stable variants - can be snapshot using variantsMD5, excluding the untar directories and files
            def vcfs_with_stable_variants = getAllFilesFromDir(params.outdir, include: ['**/*.vcf.gz'], ignore: ['untar**'])

            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    // All directories and files in the output directory
                    output_directories_and_files,
                    // VCFs with stable variants
                    vcfs_with_stable_variants.collect{ file -> [ file.getName(), path(file.toString()).vcf.variantsMD5 ] }
                ).match() }
            )
        }
    }

    test("with tumor-normal GRCh38 data") {

        setup {
        run("UNTAR", alias: "UNTAR_VEP_CACHE") {
            script "modules/nf-core/untar/main.nf"
            process {
                """
                input[0] = channel.of([
                    [id:'vep_cache'],
                    file(params.pipelines_testdata_base_path + 'reference/GRCh38/vep_cache.tar.gz', checkIfExists: true)
                ])
                """
                }
            }
        }

        when {
            params {
                outdir = "$outputDir"
            }

            workflow {
                """
                input[0] = channel.of([
                    [id:'reference'],
                    file(params.pipelines_testdata_base_path + 'reference/GRCh38/GRCh38_masked_exclusions_alts_hlas_subset.fasta', checkIfExists: true)
                ])
                input[1] = channel.fromPath(params.pipelines_testdata_base_path + 'reference/GRCh38/GRCh38_masked_exclusions_alts_hlas_subset.fasta.fai', checkIfExists: true).map {it -> [[id:it.simpleName], it]  }.collect()
                input[2] = channel.fromPath("$projectDir/assets/cadd_to_vcf_header.txt", checkIfExists: true).collect()
                input[3] = null
                input[4] = null
                input[5] = channel.of([
                    [id:'SNV'],
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_normal/subject_a.tumor.purple.somatic.vcf.gz', checkIfExists: true)
                ])
                input[6] = channel.of([
                    [id:'SNV'],
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_normal/subject_a.tumor.purple.sv.vcf.gz', checkIfExists: true)
                ])
                input[7] = []
                input[8] = channel.of([
                    file(params.pipelines_testdata_base_path + 'reference/GRCh38/vcfanno_functions.lua', checkIfExists: true)
                ])
                input[9] = channel.of([
                    file(params.pipelines_testdata_base_path + 'reference/GRCh38/grch38_gnomad_reformatted_merged_v4.1_subset.vcf.gz', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'reference/GRCh38/grch38_gnomad_reformatted_merged_v4.1_subset.vcf.gz.tbi', checkIfExists: true)
                ])
                input[10] = channel.of([
                    file(params.pipelines_testdata_base_path + 'reference/GRCh38/vcfanno.toml', checkIfExists: true)
                ])
                input[11] = UNTAR_VEP_CACHE.out.untar.map{ _meta, files -> [files]}.collect()
                input[12] = channel.of([
                    file(params.pipelines_testdata_base_path + 'reference/GRCh38/LoFtool_scores.txt', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'reference/GRCh38/pLI_values.txt', checkIfExists: true)
                ])
                input[13] = null
                input[14] = 'GRCh38'
                input[15] = 'homo_sapiens'
                input[16] = '115'
                """
            }
        }

        then {
            // All files and directories in the output directory, excluding the untar directories and files
            def output_directories_and_files = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['untar**'])
            // vcfs_with_stable_variants: Vcf files with stable variants - can be snapshot using variantsMD5, excluding the untar directories and files
            def vcfs_with_stable_variants = getAllFilesFromDir(params.outdir, include: ['**/*.vcf.gz'], ignore: ['untar**'])

            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    // All directories and files in the output directory
                    output_directories_and_files,
                    // VCFs with stable variants
                    vcfs_with_stable_variants.collect{ file -> [ file.getName(), path(file.toString()).vcf.variantsMD5 ] }
                ).match() }
            )
        }
    }
}
