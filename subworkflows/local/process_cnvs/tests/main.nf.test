nextflow_workflow {

    name "Test subworkflow PROCESS_CNVS"
    script "../main.nf"
    workflow "PROCESS_CNVS"
    tag "subworkflows"
    tag "subworkflows_local"
    tag "process_cnvs"

    config "./nextflow.config"
    topics "versions"

    test("with tumor-normal data") {

        when {
            workflow {
                """
                input[0] = channel.of([
                    [id: 'test_tumor_normal_case', case_id: 'test_tumor_normal_case'],
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_normal/subject_a.tumor.amber.baf.tsv.gz', checkIfExists: true),
                ])
                input[1] = channel.of([
                    [id: 'test_tumor_normal_case', case_id: 'test_tumor_normal_case'],
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_normal/subject_a.tumor.purple.cnv.gene.tsv', checkIfExists: true)
                ])
                input[2] = channel.of([
                    [id: 'test_tumor_normal_case', case_id: 'test_tumor_normal_case'],
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_normal/subject_a.tumor.purple.cnv.somatic.tsv', checkIfExists: true)
                ])
                input[3] = channel.of([
                    [id: 'test_tumor_normal_case', case_id: 'test_tumor_normal_case', sample_id: 'subject_a', sample_type: 'normal', sex: 'female'],
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_normal/subject_a.normal.cobalt.ratio.pcf', checkIfExists: true)
                ])
                input[4] = channel.of([
                    [id: 'test_tumor_normal_case', case_id: 'test_tumor_normal_case', sample_id: 'subject_a', sample_type: 'tumor', sex: 'female'],
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_normal/subject_a.tumor.cobalt.ratio.pcf', checkIfExists: true)
                ])
                input[5] = "tumor_normal"
                """
            }
        }

        then {
            def output_tbis = workflow.out.findAll { key, value -> key.endsWith('_tbi') }
                .collectMany { key, value -> value }

            assert workflow.success
            assertAll(
                { assert snapshot(
                    workflow.out.gens_baf_normal_tsv,
                    workflow.out.gens_baf_tumor_tsv,
                    workflow.out.gens_cov_bed,
                    output_tbis.collect { meta, tbi -> [meta, file(tbi).name] },
                    // only snapshot name as md5sum will change with every run due to presence of timestamps.
                    workflow.out.html_report.collect { meta, html -> [ meta, file(html).name]} ,
                    topics,
                ).match() }
            )
        }
    }

    test("with tumor-normal data - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = channel.of([
                    [id: 'test_tumor_normal_case', case_id: 'test_tumor_normal_case'],
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_normal/subject_a.tumor.amber.baf.tsv.gz', checkIfExists: true),
                ])
                input[1] = channel.of([
                    [id: 'test_tumor_normal_case', case_id: 'test_tumor_normal_case'],
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_normal/subject_a.tumor.purple.cnv.gene.tsv', checkIfExists: true)
                ])
                input[2] = channel.of([
                    [id: 'test_tumor_normal_case', case_id: 'test_tumor_normal_case'],
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_normal/subject_a.tumor.purple.cnv.somatic.tsv', checkIfExists: true)
                ])
                input[3] = channel.of([
                    [id: 'test_tumor_normal_case', case_id: 'test_tumor_normal_case', sample_id: 'subject_a', sample_type: 'normal', sex: 'female'],
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_normal/subject_a.normal.cobalt.ratio.pcf', checkIfExists: true)
                ])
                input[4] = channel.of([
                    [id: 'test_tumor_normal_case', case_id: 'test_tumor_normal_case', sample_id: 'subject_a', sample_type: 'tumor', sex: 'female'],
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_normal/subject_a.tumor.cobalt.ratio.pcf', checkIfExists: true)
                ])
                input[5] = "tumor_normal"
                """
            }
        }

        then {
            assert workflow.success
            assertAll(
                { assert snapshot(
                    sanitizeOutput(workflow.out),
                ).match() }
            )
        }
    }

