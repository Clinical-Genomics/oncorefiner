/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run Clinical-Genomics/oncorefiner -profile test_tumor_only,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

// Include all additional parameters from the tumor normal test config (default)
includeConfig 'test_tumor_normal.config'

params {
    config_profile_name        = 'Test profile - Tumor only testdata'
    config_profile_description = 'Minimal Tumor only test dataset to check pipeline function'

    snv_vcf    = params.pipelines_testdata_base_path + 'testdata/tumor_only/subject_a.tumor.purple.somatic.vcf.gz'
    sv_vcf     = params.pipelines_testdata_base_path + 'testdata/tumor_only/subject_a.tumor.purple.sv.vcf.gz'
    bam_normal = null
    bai_normal = null
}
