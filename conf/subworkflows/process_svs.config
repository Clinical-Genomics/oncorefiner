/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    withName: '.*:PROCESS_SVS:SVDB_QUERY' {
        ext.when  = {!params.svdb_query_dbs.equals(null)}
        ext.prefix = { "${meta.id}_SV_annotated_svdb" }
    }

    withName: '.*:PROCESS_SVS:ENSEMBLVEP_VEP' {
        ext.args = { [
            "${params.extra_args_sv_vep}",
            '--dir_cache cache',
            '--dir_plugins cache/Plugins',
            '--plugin pLI,pLI_values.txt',
            '--appris --biotype --buffer_size 100 --canonical --cache --ccds',
            '--compress_output bgzip --distance 5000 --domains',
            '--exclude_predicted --force_overwrite --format vcf',
            '--hgvs --humdiv --max_sv_size 248956422 --merged',
            '--no_progress --numbers --per_gene --polyphen p',
            '--protein --offline --regulatory --sift p',
            '--symbol --tsl --uniprot --vcf',
            '--allow_non_variant --dont_skip'
        ].join(' ') }
        ext.prefix = { "${meta.id}_SV_annotated_vep" }
    }

    withName: '.*:PROCESS_SVS:BCFTOOLS_VIEW_RESEARCH' {
        ext.args = { '--output-type z --write-index=tbi' }
        ext.prefix = { "${meta.id}_SV_research_filtered_bcftools" }
    }

    withName: '.*:PROCESS_SVS:BCFTOOLS_VIEW_CLINICAL' {
        ext.args = { '--output-type z --write-index=tbi' }
        ext.prefix = { "${meta.id}_SV_clinical_filtered_bcftools" }
    }

    withName: '.*:PROCESS_SVS:VCF_ANNOTATE_SCORE_GENMOD:BCFTOOLS_VIEW' {
        ext.prefix = { "${meta.id}_SV_genmod_score" }
    }
}
