/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    withName: '.*:PROCESS_SVS:SVDB_QUERY' {
        ext.when  = {!params.svdb_query_dbs.equals(null)}
        ext.prefix = { "${meta.case_id}_SV_annotated_svdb" }
    }

    withName: '.*:PROCESS_SVS:ENSEMBLVEP_VEP' {
        ext.args = { [
            "${params.extra_args_sv_vep}",
            '--dir_plugins cache/Plugins --vcf',
            '--compress_output bgzip --format vcf',
            '--max_sv_size -1',
            '--allow_non_variant --dont_skip',
            '--buffer_size 5000 --distance 5000',
            '--force_overwrite',
            '--offline --cache --merged',
            '--exclude_predicted --no_progress --no_stats',
            '--per_gene --variant_class',
            '--appris --biotype --canonical --ccds --domains --numbers',
            '--protein --regulatory --symbol --mirna --gene_phenotype',
            '--tsl --uniprot --mane --hgvs',
            '--polyphen b --sift b',
            '--af --af_1kg --max_af',
            '--af_gnomade --af_gnomadg'
        ].join(' ') }
        ext.prefix = { "${meta.case_id}_SV_annotated_vep" }
    }

    withName: '.*:PROCESS_SVS:BCFTOOLS_VIEW_RESEARCH' {
        ext.args = { '--output-type z --write-index=tbi' }
        ext.prefix = { "${meta.case_id}_SV_research_filtered_bcftools" }
    }

    withName: '.*:PROCESS_SVS:BCFTOOLS_VIEW_CLINICAL' {
        ext.args = { [
        "--include 'INFO/REPORTED || (INFO/gnomad_svAF <= 0.01 || INFO/gnomad_svAF == \".\") && (INFO/swegenAF <= 0.01 || INFO/swegenAF == \".\")' ",
        '--output-type z --write-index=tbi'
        ].join(' ') }
        ext.prefix = { "${meta.case_id}_SV_clinical_filtered_bcftools" }
    }

    withName: '.*:PROCESS_SVS:VCF_ANNOTATE_SCORE_GENMOD:BCFTOOLS_VIEW' {
        ext.prefix = { "${meta.case_id}_SV_score_genmod" }
    }
}
