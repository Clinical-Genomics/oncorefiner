/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run Clinical-Genomics/oncorefiner -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}


params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function using GRCh38'

    // Input data

    input               = params.pipelines_testdata_base_path + 'testdata/samplesheet_test.csv'
    snv_vcf             = params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_normal/subject_a.tumor.purple.somatic.vcf.gz'
    sv_vcf              = params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_normal/subject_a.tumor.purple.sv.vcf.gz'
    bam_normal          = params.pipelines_testdata_base_path + 'testdata/GRCh38/subject_a.normal.redux.bam'
    bai_normal          = params.pipelines_testdata_base_path + 'testdata/GRCh38/subject_a.normal.redux.bam.bai'
    bam_tumor           = params.pipelines_testdata_base_path + 'testdata/GRCh38/subject_a.tumor.redux.bam'
    bai_tumor           = params.pipelines_testdata_base_path + 'testdata/GRCh38/subject_a.tumor.redux.bam.bai'
    sex                 = 'female'

    genome              = 'GRCh38'
    fasta               = params.pipelines_testdata_base_path + 'reference/GRCh38/GRCh38_masked_exclusions_alts_hlas_subset.fasta'
    fai                 = params.pipelines_testdata_base_path + 'reference/GRCh38/GRCh38_masked_exclusions_alts_hlas_subset.fasta.fai'

    vep_cache           = params.pipelines_testdata_base_path + 'reference/GRCh38/vep_cache.tar.gz'
    vep_cache_version   = 115
    //vep_plugin_files    = params.pipelines_testdata_base_path + 'reference/GRCh38/vep_files.csv'
    vep_plugin_files    = '/Users/kristinebilgrav/Development/vep_files.csv'

    vcfanno_toml        = params.pipelines_testdata_base_path + 'reference/GRCh38/grch38_vcfanno_config.toml'
    //vcfanno_resources   = params.pipelines_testdata_base_path + 'reference/GRCh38/grch38_vcfanno_resources.txt'
    vcfanno_resources   = '/Users/kristinebilgrav/Development/grch38_vcfanno_resources.txt'
    vcfanno_lua         = params.pipelines_testdata_base_path + 'reference/GRCh38/vcfanno_functions.lua'

    //svdb_query_dbs      = params.pipelines_testdata_base_path + 'reference/GRCh38/svdb_querydb_files.csv'
    svdb_query_dbs      = '/Users/kristinebilgrav/Development/svdb_querydb_files.csv'

    // TODO make/insert mock input for CADD
}
