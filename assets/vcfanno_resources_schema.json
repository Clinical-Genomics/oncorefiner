{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/nf-core/raredisease/master/assets/vcfanno_resources_schema.json",
  "description": "Schema for the vcfanno resources input. One line per resource file.",
  "type": "array",
  "items": {
    "type": "string",
    "format": "file-path",
    "exists": true,
    "pattern": "^\\S+\\.(vcf\\.gz|tsv\\.gz|bed\\.gz|vcf\\.gz\\.tbi|tsv\\.gz\\.tbi|bed\\.gz\\.tbi|csi)$"
    }
  }