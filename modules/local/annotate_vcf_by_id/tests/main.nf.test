nextflow_process {

    name "Test Process ANNOTATE_VCF_BY_ID"
    script "../main.nf"
    process "ANNOTATE_VCF_BY_ID"
    tag "modules"
    tag "modules_local"
    tag "annotate_vcf_by_id"

    config "./nextflow.config"

    test("Annotate VCF by ID, tumor-normal") {

        setup {
            run("COMBINE_LINX_TSV") {
                script "modules/local/combine_linx_tsv/main.nf"
                process {
                    """
                    input[0] = [
                    [ id:'test' ],
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_normal/subject_a.tumor.linx.fusion.tsv', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_normal/subject_a.tumor.linx.breakend.tsv', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_normal/subject_a.tumor.linx.svs.tsv', checkIfExists: true)
                    ]
                    """
                }
            }
        }

        when {

            process {
                """
                ch_input = channel.of([
                    [ id:'test' ],
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_normal/subject_a.tumor.purple.sv.vcf.gz', checkIfExists: true)
                    ])
                    .join(COMBINE_LINX_TSV.out.tsv, failOnMismatch: true)
                    .combine( channel.fromPath('$projectDir/assets/sv_annotation_header.txt') )
                input[0] = ch_input.map { meta, vcf, tsv, header -> tuple(meta, vcf, tsv, header) }

                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out.vcf.collect { meta, vcf -> [meta, file(vcf).name + ":variantsMD5," + path(vcf).vcf.variantsMD5 ]} ,
                    process.out.tbi.collect { meta, tbi -> [meta, file(tbi).name ]} ,
                    process.out.findAll { key, val -> key.startsWith("versions") } ,
                ).match() }
            )
        }
    }

    test("Annotate VCF by ID, tumor-normal - stub") {

        options "-stub"

        setup {
            run("COMBINE_LINX_TSV") {
                script "modules/local/combine_linx_tsv/main.nf"
                process {
                    """
                    input[0] = [
                    [ id:'test' ],
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_normal/subject_a.tumor.linx.fusion.tsv', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_normal/subject_a.tumor.linx.breakend.tsv', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_normal/subject_a.tumor.linx.svs.tsv', checkIfExists: true)
                    ]
                    """
                }
            }
        }

        when {

            process {
                """
                ch_input = channel.of([
                    [ id:'test' ],
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_normal/subject_a.tumor.purple.sv.vcf.gz', checkIfExists: true)
                    ])
                    .join(COMBINE_LINX_TSV.out.tsv, failOnMismatch: true)
                    .combine( channel.fromPath('$projectDir/assets/sv_annotation_header.txt') )
                input[0] = ch_input.map { meta, vcf, tsv, header -> tuple(meta, vcf, tsv, header) }

                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out.vcf.collect { meta, vcf -> [meta, file(vcf).name ]} ,
                    process.out.tbi.collect { meta, tbi -> [meta, file(tbi).name ]} ,
                    process.out.findAll { key, val -> key.startsWith("versions") } ,
                ).match() }
            )
        }
    }
}
