nextflow_process {

    name "Test Process LINX_VCF"
    script "../main.nf"
    process "LINX_VCF"
    tag "modules"
    tag "modules_local"
    tag "linx_vcf"

    config "./nextflow.config"

    test("Annotate VCF with LINX TSV") {
        when {

            process {
                """
                input[0] = [
                    [ id:'vcf_in' ],
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_only/subject_a.tumor.linx.fusion.tsv', checkIfExists: true)
                ]
                input[1] = [
                    [ id:'tsv' ],
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_only/subject_a.tumor.linx.breakend.tsv', checkIfExists: true)
                ]
                input[2] = [
                    [ id:'header' ],
                    channel.fromPath("$projectDir/assets/sv_annotation_header.txt", checkIfExists: true).collect()
                ]
                input[3] = [
                    [ id:'vcf_out' ],
                    ''
                ]

                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    file(process.out.vcf[0][1]).name + ",variantsMD5:" + path(process.out.vcf[0][1]).vcf.variantsMD5,
                    file(process.out.tbi[0][1]).name,
                    process.out.findAll { key, val -> key.startsWith("versions") }
                ).match() }
            )
        }
    }
}
