                    'tumor_only'
                    ])

                """
            }
        }

        then {
            def output_tsv = process.out.findAll { key, value -> key.endsWith('_tsv')}
                .collectMany { key, value -> value}

            // All output tbi files
            def output_tbis = process.out.findAll { key, value -> key.endsWith('_tbi')}
                .collectMany { key, value -> value}

            assert process.success
            assertAll(
                { assert snapshot(
                    output_tsv,
                    output_tbis.collect { meta, tbi -> [meta, file(tbi).name ]},
                    topics
                ).match() }
            )
        }
    }

    test("Prepare AMBER files for GENS, tumor-only - stub") {

        options "-stub"

        when {

            process {
                """
                input[0] = channel.of([
                    [id: 'test_amber_gens', case_id: 'subject_a'],
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_only/subject_a.tumor.amber.baf.tsv.gz', checkIfExists: true),
                    'tumor_only'
                    ])
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out,
                ).match() }
            )
        }
    }
}
