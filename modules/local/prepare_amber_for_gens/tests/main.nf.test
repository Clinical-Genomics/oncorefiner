nextflow_process {

    name "Test Process PREPARE_AMBER_FOR_GENS"
    script "../main.nf"
    process "PREPARE_AMBER_FOR_GENS"
    tag "modules"
    tag "modules_local"
    tag "prepare_amber_for_gens"

    topics "versions"

    test("Prepare AMBER files for GENS, tumor-normal") {

        when {

            process {
                """
                input[0] = channel.of([
                    [id: 'test_amber_gens', case_id: 'test', sample_type: 'tumor_normal'],
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_normal/subject_a.tumor.purple.sv.vcf.gz', checkIfExists: true)
                    ])
                    .join(COMBINE_LINX_TSV.out.tsv, failOnMismatch: true)
                    .combine( channel.fromPath('$projectDir/assets/sv_annotation_header.txt') )

                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out.tsv,
                    process.out.tbi.collect { meta, tbi -> [meta, file(tbi).name ]},
                    topics
                ).match() }
            )
        }
    }

    test("Prepare AMBER files for GENS, tumor-normal - stub") {

        options "-stub"

        when {

            process {
                """
                input[0] = channel.of([
                    [id: 'test_amber_gens', case_id: 'test', sample_id: 'subject_a', sample_type: 'tumor_normal', sex: 'female'],
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_normal/subject_a.tumor.purple.sv.vcf.gz', checkIfExists: true)
                    ])
                    .join(COMBINE_LINX_TSV.out.tsv, failOnMismatch: true)
                    .combine( channel.fromPath('$projectDir/assets/sv_annotation_header.txt') )

                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out,
                ).match() }
            )
        }
    }
}
