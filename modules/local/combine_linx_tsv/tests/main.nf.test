nextflow_process {

    name "Test Process COMBINE_LINX_TSV"
    script "../main.nf"
    process "COMBINE_LINX_TSV"
    tag "modules"
    tag "modules_local"
    tag "combine_linx_tsv"
    config "./nextflow.config"

    test("Test combining the LINX TSVs into annotation compatible TSV, tumor-normal") {
        when {

            process {
                """
                input[0] = [
                    [id: 'test', case_id: 'test', sample_id: 'subject_a', sample_type: 'tumor_normal', sex: 'female'],
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_normal/subject_a.tumor.linx.fusion.tsv', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_normal/subject_a.tumor.linx.breakend.tsv', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_normal/subject_a.tumor.linx.svs.tsv', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out.tsv,
                    process.out.findAll { key, val -> key.startsWith("versions") },
                ).match() }
            )
        }
    }

    test("Test combining the LINX TSVs into annotation compatible TSV, tumor-normal - stub") {

        options "-stub"

        when {

            process {
                """
                input[0] = [
                    [id: 'test', case_id: 'test', sample_id: 'subject_a', sample_type: 'tumor_normal', sex: 'female'],
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_normal/subject_a.tumor.linx.fusion.tsv', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_normal/subject_a.tumor.linx.breakend.tsv', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'testdata/GRCh38/tumor_normal/subject_a.tumor.linx.svs.tsv', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out.tsv,
                    process.out.findAll { key, val -> key.startsWith("versions") },
                ).match() }
            )
        }
    }
}
